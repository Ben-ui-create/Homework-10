<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
    />

    <title>Posts</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 40px;
            max-width: 700px;
            margin: 0 auto;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 30px;
        }

        input,
        textarea {
            padding: 10px;
            font-size: 16px;
        }

        button {
            padding: 10px;
            cursor: pointer;
        }

        .post {
            border: 1px solid #ccc;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        h3 {
            margin-top: 0;
        }
    </style>
</head>
<body>

<h1>Posts</h1>

<form id="postForm">
    <input
            type="text"
            id="title"
            placeholder="Title"
            required
    />

    <textarea
            id="content"
            placeholder="Content"
            required
    ></textarea>

    <button type="submit">
        Create Post
    </button>
</form>

<div id="posts"></div>

<script src="/js/posts.js"></script>
</body>
</html>